# syntax=docker/dockerfile:1.7

FROM node:22.23.1-bookworm-slim AS dependencies

ENV NODE_ENV=production
WORKDIR /opt/nyc311

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force

FROM node:22.23.1-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 nyc311 \
    && useradd --uid 10001 --gid nyc311 --no-create-home --shell /usr/sbin/nologin nyc311 \
    && install -d -o nyc311 -g nyc311 /data /backups \
    && install -d -o root -g root /imports /locks

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=10000 \
    DATABASE_PATH=/data/portal-archive.sqlite
WORKDIR /opt/nyc311

COPY --from=dependencies --chown=nyc311:nyc311 /opt/nyc311/node_modules ./node_modules
COPY --chown=nyc311:nyc311 package.json package-lock.json ./
COPY --chown=nyc311:nyc311 *.js ./
COPY --chown=nyc311:nyc311 exports/nyc-bid-boundaries-2026-04-28.geojson ./exports/nyc-bid-boundaries-2026-04-28.geojson
COPY --chown=nyc311:nyc311 public ./public

# Keep the commit-specific image metadata after every reusable runtime and
# application layer. A new release SHA should not invalidate apt, users,
# dependencies, or unchanged application files.
ARG APP_VERSION=development
LABEL org.opencontainers.image.title="NYC 311 Live SQLite services" \
      org.opencontainers.image.version="${APP_VERSION}"

USER 10001:10001
EXPOSE 10000
STOPSIGNAL SIGTERM

CMD ["node", "server.js"]
