# Render supplies this automatically to the web and worker services.
DATABASE_URL=postgresql://user:password@host:5432/nyc311

# Required on the hosted dashboard. Do not commit the real password.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

POLL_INTERVAL_SECONDS=15
AUDIT_DELAY_MINUTES=35
DETAIL_REQUEST_DELAY_MS=750
AUDIT_REQUEST_DELAY_MS=750

# Used only when importing the current Mac database.
SQLITE_PATH=/Users/you/Library/Application Support/nyc-bid-311/portal-archive.sqlite
