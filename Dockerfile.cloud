# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS dependencies

ENV NODE_ENV=production
WORKDIR /opt/nyc311

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force

FROM node:22-bookworm-slim AS runtime

ARG APP_VERSION=development
LABEL org.opencontainers.image.title="NYC 311 Live cloud services" \
      org.opencontainers.image.version="${APP_VERSION}"

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=10000
WORKDIR /opt/nyc311

COPY --from=dependencies --chown=node:node /opt/nyc311/node_modules ./node_modules
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node portal-timestamp.js ./portal-timestamp.js
COPY --chown=node:node cloud ./cloud
COPY --chown=node:node public ./public

USER node
EXPOSE 10000
STOPSIGNAL SIGTERM

# Role-specific health checks and commands live in the Compose/ECS definition so
# this one image can safely serve the web, worker, migration, and import roles.
CMD ["node", "cloud/server.js"]
