# Copy to .env on the Lightsail instance, set mode 0600, and fill every blank.
# Generate the dashboard password with: openssl rand -hex 32

COMPOSE_PROJECT_NAME=nyc311
# Use the immutable Git commit SHA for every deployment.
IMAGE_TAG=replace-with-git-sha

# A DNS name whose A record points to the attached Lightsail static IP.
# These may remain blank during a private SSH-tunnel rehearsal.
SITE_ADDRESS=
ACME_EMAIL=

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Dedicated SES receiving subdomain. Individual request aliases are generated
# locally; they are not provisioned as mailboxes.
INBOUND_EMAIL_DOMAIN=track.opendata.support
# Generate once with `openssl rand -hex 32` and use the identical value in the
# inbound-email CloudFormation stack. Never commit the populated .env file.
INBOUND_EMAIL_WEBHOOK_SECRET=

SQLITE_IMPORT_FILE=portal-archive.sqlite
BACKUP_RETENTION_COUNT=3

# Activation is blocked until Lightsail recovery snapshots are enabled/created
# and a verified restore rehearsal has succeeded. Change both only afterward.
OFFSITE_BACKUPS_CONFIRMED=0
RESTORE_TEST_CONFIRMED=0

POLL_INTERVAL_SECONDS=15
AUDIT_DELAY_MINUTES=35
DETAIL_REQUEST_DELAY_MS=2500
AUDIT_MAX_PARALLEL=2
AUDIT_REQUEST_DELAY_MS=500

# FULL adds cloud power-loss durability. The local Mac default remains NORMAL.
SQLITE_SYNCHRONOUS=FULL
