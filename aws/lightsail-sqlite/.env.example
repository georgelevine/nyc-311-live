# Copy to .env on the Lightsail instance, set mode 0600, and fill every blank.
# Generate the dashboard password with: openssl rand -hex 32

COMPOSE_PROJECT_NAME=nyc311
# Service workers and the web/API have separate immutable pointers so a web-only
# deployment can never roll the collector or inbound-email process forward.
IMAGE_TAG=replace-with-git-sha
WEB_IMAGE_TAG=replace-with-git-sha

# A DNS name whose A record points to the attached Lightsail static IP.
# These may remain blank during a private SSH-tunnel rehearsal.
SITE_ADDRESS=
ACME_EMAIL=

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Dedicated SES receiving subdomain. Individual request aliases are generated
# locally; they are not provisioned as mailboxes.
INBOUND_EMAIL_DOMAIN=track.opendata.support
# Generate once with `openssl rand -hex 32` and use the identical value in the
# inbound-email CloudFormation stack. Never commit the populated .env file.
INBOUND_EMAIL_WEBHOOK_SECRET=
# Optional automated NYC311 subscriptions. All-request mode applies only to
# records first seen at or after the immutable activation timestamp.
EMAIL_SUBSCRIBE_BID_IDS=
EMAIL_SUBSCRIBE_PRECINCTS=
EMAIL_PRECINCT_START_AT=
EMAIL_SUBSCRIBE_ALL_NEW=0
EMAIL_ALL_START_AT=
EMAIL_SUBSCRIPTION_DELAY_MS=5000
# Two live lanes plus one historical catch-up lane.
EMAIL_SUBSCRIPTION_WORKERS=3
INITIAL_EMAIL_ENDPOINT=

# Set to 0 to stop blanket 24-hour Portal status checks. Initial detail
# hydration, map observations, subscriptions, and email-triggered closure
# verification continue to run.
SCHEDULED_OPEN_FOLLOWUPS_ENABLED=1

SQLITE_IMPORT_FILE=portal-archive.sqlite
BACKUP_RETENTION_COUNT=3

# Activation is blocked until Lightsail recovery snapshots are enabled/created
# and a verified restore rehearsal has succeeded. Change both only afterward.
OFFSITE_BACKUPS_CONFIRMED=0
RESTORE_TEST_CONFIRMED=0

POLL_INTERVAL_SECONDS=15
# Opt in only after the pinned BID boundaries are installed in this database.
COLLECTOR_SCOPE=citywide
# The current production archive can safely remain here when switching scope;
# existing citywide rows are retained for rollback but hidden in BID-only mode.
# A different filename is also supported when a genuinely separate archive is
# desired, provided it is a plain .sqlite file directly inside /data.
DATABASE_PATH=/data/portal-archive.sqlite
BID_POLL_INTERVAL_SECONDS=60
BID_QUERY_CONCURRENCY=3
BID_QUERY_ZONE_TARGET=12
BID_CATCHUP_MAX_DAYS=2
AUDIT_DELAY_MINUTES=35
DETAIL_REQUEST_DELAY_MS=2500
AUDIT_MAX_PARALLEL=2
AUDIT_REQUEST_DELAY_MS=500

# FULL adds cloud power-loss durability. The local Mac default remains NORMAL.
SQLITE_SYNCHRONOUS=FULL
# Wait through short writer overlap instead of dropping collector, audit, or
# inbound-email writes. Keep this at or below five minutes.
SQLITE_BUSY_TIMEOUT_MS=30000
