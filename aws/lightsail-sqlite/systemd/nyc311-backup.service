[Unit]
Description=Verified NYC 311 Live SQLite backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/nyc-311-live/aws/lightsail-sqlite/.env
ConditionPathExists=/var/lib/nyc-311-live/portal-archive.sqlite

[Service]
Type=oneshot
TimeoutStartSec=infinity
WorkingDirectory=/opt/nyc-311-live/aws/lightsail-sqlite
ExecStart=/usr/bin/docker compose --profile tools run --rm backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
