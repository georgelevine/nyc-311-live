[Unit]
Description=Verified NYC 311 Live SQLite backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/nyc-311-live/aws/lightsail-sqlite/.env

[Service]
Type=oneshot
TimeoutStartSec=infinity
WorkingDirectory=/opt/nyc-311-live/aws/lightsail-sqlite
ExecStart=/usr/bin/docker compose --profile tools run --rm backup
# The Compose command also applies these priorities inside the short-lived
# backup container. These host-side values are defense in depth for the client.
Nice=19
IOSchedulingClass=idle
