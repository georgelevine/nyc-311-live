# Copy this file to .env, keep it mode 0600, and fill every blank value.
# Never commit .env. Generate each password separately with: openssl rand -hex 32

COMPOSE_PROJECT_NAME=nyc311
IMAGE_TAG=local

# A public DNS name whose A record points at the Lightsail static IP.
SITE_ADDRESS=
ACME_EMAIL=

# Keep these identifiers URL-safe. POSTGRES_PASSWORD must be hexadecimal because
# Compose inserts it into DATABASE_URL for the application containers.
POSTGRES_USER=nyc311_app
POSTGRES_PASSWORD=
POSTGRES_DB=nyc311
DB_HOST=db
DB_PORT=5432
PGSSLMODE=disable

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

POLL_INTERVAL_SECONDS=15
# This legacy PostgreSQL stack rejects bid_only instead of silently collecting
# citywide data. Use the SQLite/Lightsail stack for BID-only collection.
COLLECTOR_SCOPE=citywide
AUDIT_DELAY_MINUTES=35
DETAIL_REQUEST_DELAY_MS=750
AUDIT_REQUEST_DELAY_MS=750

# The file must be placed in aws/lightsail/imports/ on the server.
SQLITE_IMPORT_FILE=portal-archive.sqlite
